# Text files are stored and checked out with LF on every platform, so a package
# built from a Windows checkout is byte-for-byte the same as one built elsewhere.
* text=auto eol=lf

# Files that exist only in the repository and are not part of the extension
# package (keeps `git archive` output equal to what the build scripts pack).
/tests export-ignore
/scripts export-ignore
/chromium export-ignore
/README.md export-ignore
/CHANGELOG.md export-ignore
/LICENSE export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
