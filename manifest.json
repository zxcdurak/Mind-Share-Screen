{
  "manifest_version": 2,
  "name": "Mind for Firefox",
  "version": "1.3",
  "description": "Fixes the desktop screen-sharing feature of i.Mind video conferencing on e-class.tsu.ru when used in Firefox.",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{35c62f32-e3aa-44b6-a1b3-3169464b175e}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://e-class.tsu.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["inject.js"]
}
